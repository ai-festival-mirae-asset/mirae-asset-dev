# ---------------------------------------------------------------------------
# 팀 공용 설정 견본 (.env.example)
#
# 이 파일은 "값이 비어 있는 견본"이라 저장소에 함께 올립니다.
# 실제 값이 들어가는 .env 는 .gitignore 로 막아 두었으니 절대 커밋되지 않습니다.
#
# [처음 받았을 때 할 일]
#   1. 이 파일을 복사해서 이름을 .env 로 바꿉니다.
#        Windows :  copy .env.example .env
#        Mac/Linux:  cp .env.example .env
#   2. 아래 CLOVASTUDIO_API_KEY 의 = 뒤에 팀에서 받은 키를 붙여넣습니다.
#   3. 확인 :  python config/env_loader.py
#
# [주의] .env 파일이나 키 값을 GitHub, 공개 채팅방, 스크린샷에 올리지 마세요.
# ---------------------------------------------------------------------------

# CLOVA Studio API 키 — 필수. 없으면 CLOVA 호출 단계가 시작부터 실패합니다.
# 값 예시 형태: nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOVASTUDIO_API_KEY=

# KRX 로그인 세션 쿠키 — ETF 구성종목을 새로 수집할 때만 필요합니다.
# 평소 개발에는 비워 두어도 됩니다.
KRX_COOKIE=

# 원본 엑셀 8개가 든 폴더 경로 — 저장소 안 datasets/ 에 두었다면 비워 두세요.
# 다른 위치(예: 외장 디스크)에 두었을 때만 경로를 적습니다.
# Windows 예시: MIRAE_DATASETS=C:\Users\내이름\Downloads\datasets
MIRAE_DATASETS=

# 실제 CLOVA 호출까지 포함해 테스트할 때 1 로 둡니다(호출 비용 발생).
# 평소에는 비워 두세요.
RUN_LIVE_LLM=
