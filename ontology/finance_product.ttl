@prefix mafp: <https://ai-festival.mirae-asset.com/ontology/finance-product#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

################################################################################
# 온톨로지 선언
#
# 설계 원칙
#   1. 관측되지 않은 값과 값이 0인 것을 구분한다. 모든 지표는 값·관측여부·출처·기준일을
#      하나의 Observation 노드로 묶는다. 결측을 0으로 채우면 순위 질의가 조용히 틀린다.
#   2. 상품군마다 개념이 없는 지표가 있다. 채권에는 총보수가 없고 해외 ETF에는 위험등급이
#      없다. 이를 "값 없음"이 아니라 "적용 불가"로 구분한다.
#   3. 제약은 답변 가능성 판정의 근거가 된다. 위험등급 1~6 밖의 값, 종료 상품의 -100%
#      수익률처럼 데이터에서 실제로 관측된 오염을 온톨로지 수준에서 차단한다.
################################################################################

<https://ai-festival.mirae-asset.com/ontology/finance-product>
    a owl:Ontology ;
    dct:title "미래에셋 AI Festival 금융상품 온톨로지"@ko ;
    dct:description """주최 측 2026-07-11 스냅샷 4종(국내채권·국내 ETP·해외 ETP·공모펀드)의
    상품 개념, 지표 관측, 데이터 품질 상태를 기술한다. 값의 존재 여부와 출처를 명시적으로
    모델링해 '데이터에 없음'과 '조건에 맞는 상품 없음'을 구분한다."""@ko ;
    dct:source "PRBD01N001, PREF01N001, PREF02N001, PRFD01N001 (2026-07-11 추출)" ;
    owl:versionInfo "0.1.0" .

################################################################################
# 1. 상품 클래스
################################################################################

mafp:FinancialProduct a owl:Class ;
    rdfs:label "금융상품"@ko ;
    rdfs:comment "논리 상품 1건. 원본 행이 아니라 상품 단위다. 공모펀드는 속성코드가 결합된 원본 행이 아니라 itm_no 기준 논리 상품을 가리킨다."@ko .

mafp:Bond a owl:Class ; rdfs:subClassOf mafp:FinancialProduct ; rdfs:label "채권"@ko .
mafp:ExchangeTradedProduct a owl:Class ; rdfs:subClassOf mafp:FinancialProduct ; rdfs:label "상장지수상품"@ko .
mafp:ETF a owl:Class ; rdfs:subClassOf mafp:ExchangeTradedProduct ; rdfs:label "상장지수펀드"@ko .
mafp:ETN a owl:Class ; rdfs:subClassOf mafp:ExchangeTradedProduct ; rdfs:label "상장지수증권"@ko .
mafp:PublicFund a owl:Class ; rdfs:subClassOf mafp:FinancialProduct ; rdfs:label "공모펀드"@ko .

# ETF와 ETN은 겹치지 않는다. 원본 파일명이 "국내ETF마스터"지만 내용의 30.7%가 ETN이므로
# 파일 단위로 ETF라고 단정하면 안 된다.
[] a owl:AllDisjointClasses ; owl:members ( mafp:ETF mafp:ETN ) .
[] a owl:AllDisjointClasses ; owl:members ( mafp:Bond mafp:ExchangeTradedProduct mafp:PublicFund ) .

mafp:DomesticETF a owl:Class ; rdfs:subClassOf mafp:ETF ; rdfs:label "국내 ETF"@ko .
mafp:DomesticETN a owl:Class ; rdfs:subClassOf mafp:ETN ; rdfs:label "국내 ETN"@ko .
mafp:OverseasETF a owl:Class ; rdfs:subClassOf mafp:ETF ; rdfs:label "해외 ETF"@ko .
mafp:OverseasETN a owl:Class ; rdfs:subClassOf mafp:ETN ; rdfs:label "해외 ETN"@ko .

################################################################################
# 2. 관측 노드 — 값·관측여부·출처·기준일을 함께 묶는다
################################################################################

mafp:Observation a owl:Class ;
    rdfs:label "지표 관측"@ko ;
    rdfs:comment "하나의 지표에 대한 값과 그 값의 신뢰 맥락. 값이 없는 관측도 노드로 존재하며 statusNote로 사유를 남긴다."@ko .

mafp:ExpenseRatioObservation a owl:Class ; rdfs:subClassOf mafp:Observation ; rdfs:label "총보수 관측"@ko .
mafp:AumObservation a owl:Class ; rdfs:subClassOf mafp:Observation ; rdfs:label "순자산 관측"@ko .
mafp:ReturnObservation a owl:Class ; rdfs:subClassOf mafp:Observation ; rdfs:label "수익률 관측"@ko .
mafp:RiskGradeObservation a owl:Class ; rdfs:subClassOf mafp:Observation ; rdfs:label "위험등급 관측"@ko .
mafp:CreditGradeObservation a owl:Class ; rdfs:subClassOf mafp:Observation ; rdfs:label "신용등급 관측"@ko .

mafp:hasObservation a owl:ObjectProperty ;
    rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:Observation ;
    rdfs:label "관측 보유"@ko .

mafp:observedValue a owl:DatatypeProperty ;
    rdfs:domain mafp:Observation ;
    rdfs:label "관측값"@ko ;
    rdfs:comment "관측되지 않았으면 이 속성 자체를 생성하지 않는다. 0으로 채우지 않는다."@ko .

mafp:isObserved a owl:DatatypeProperty ;
    rdfs:domain mafp:Observation ; rdfs:range xsd:boolean ;
    rdfs:label "관측 여부"@ko .

mafp:asOfDate a owl:DatatypeProperty ;
    rdfs:domain mafp:Observation ; rdfs:range xsd:date ;
    rdfs:label "기준일"@ko ;
    rdfs:comment "추출일이 아니라 그 값이 실제로 갱신된 날짜. 국내 ETP 일간 데이터는 주로 2026-06-15로 추출일보다 26일 이르다."@ko .

mafp:hasSource a owl:ObjectProperty ;
    rdfs:domain mafp:Observation ; rdfs:range mafp:DataSource ;
    rdfs:label "출처"@ko .

mafp:statusNote a owl:DatatypeProperty ;
    rdfs:domain mafp:Observation ; rdfs:range xsd:string ;
    rdfs:label "상태 사유"@ko .

################################################################################
# 3. 출처 — 공식 스냅샷과 외부 보강을 절대 섞지 않는다
################################################################################

mafp:DataSource a owl:Class ; rdfs:label "데이터 출처"@ko .

mafp:OfficialSnapshot a mafp:DataSource ;
    rdfs:label "주최 측 공식 스냅샷"@ko ;
    dct:date "2026-07-11"^^xsd:date ;
    rdfs:comment "평가 기준 데이터. 외부 데이터와 상충하면 항상 이쪽이 우선한다."@ko .

mafp:ApprovedProductNameParse a mafp:DataSource ;
    rdfs:label "승인된 상품명 해석"@ko ;
    rdfs:comment "사람이 승인한 상품명 파싱 결과. 원본 컬럼은 공란 그대로 보존하고 파생 필드에만 반영한다."@ko .

mafp:ExternalKrx a mafp:DataSource ;
    rdfs:label "KRX 종목정보"@ko ;
    dct:date "2026-08-06"^^xsd:date ;
    rdfs:comment "공식값이 관측되지 않은 자리에만 사용한다. 공식값을 덮어쓰지 않는다."@ko .

mafp:ExternalKofia a mafp:DataSource ;
    rdfs:label "KOFIA 펀드별 보수비용비교"@ko ;
    dct:date "2026-08-05"^^xsd:date .

################################################################################
# 4. 데이터 품질 상태 — 답변 가능성 판정의 근거
################################################################################

mafp:QualityStatus a owl:Class ; rdfs:label "품질 상태"@ko .
mafp:Usable a mafp:QualityStatus ; rdfs:label "사용 가능"@ko .
mafp:IncompleteCore a mafp:QualityStatus ; rdfs:label "핵심 필드 불완전"@ko .
mafp:NeedsReview a mafp:QualityStatus ; rdfs:label "업무 확인 필요"@ko .
mafp:Quarantined a mafp:QualityStatus ;
    rdfs:label "격리"@ko ;
    rdfs:comment "검색·집계에서 제외한다. 원본 행은 보존하되 상품으로 취급하지 않는다."@ko .

mafp:hasQualityStatus a owl:ObjectProperty ;
    rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:QualityStatus .

mafp:isDefaultSearchEligible a owl:DatatypeProperty ;
    rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:boolean ;
    rdfs:label "기본 검색 대상"@ko ;
    rdfs:comment "거래종료·거래정지·핵심 필드 불완전 상품은 false. 사용자가 명시적으로 요청할 때만 포함한다."@ko .

mafp:NotApplicable a owl:Class ;
    rdfs:label "적용 불가"@ko ;
    rdfs:comment "상품군에 개념 자체가 없는 경우. 채권의 총보수, 해외 ETF의 위험등급이 여기 해당한다. '값이 없다'와 구분한다."@ko .

################################################################################
# 5. 상장 상태 — 99991231은 만기 없음이 아니라 미종료다
################################################################################

mafp:ListingStatus a owl:Class ; rdfs:label "상장 상태"@ko .
mafp:ActiveNotEnded a mafp:ListingStatus ;
    rdfs:label "미종료"@ko ;
    rdfs:comment "원본 거래종료일 sentinel 99991231. 만기가 없다는 뜻이 아니라 추출일 시점에 아직 종료되지 않았다는 뜻이다. 계약상 만기가 있는 활성 ETN 381건도 이 값이다."@ko .
mafp:EndedBeforeExtract a mafp:ListingStatus ;
    rdfs:label "추출일 이전 종료"@ko ;
    rdfs:comment "종료 상품의 기간수익률 -100%는 종가 0에서 계산된 대체값이지 실제 손실이 아니다."@ko .
mafp:ActiveUntilDate a mafp:ListingStatus ; rdfs:label "종료예정일 있음"@ko .

mafp:hasListingStatus a owl:ObjectProperty ;
    rdfs:domain mafp:ExchangeTradedProduct ; rdfs:range mafp:ListingStatus .

mafp:isSuspended a owl:DatatypeProperty ;
    rdfs:domain mafp:ExchangeTradedProduct ; rdfs:range xsd:boolean ;
    rdfs:label "거래정지"@ko ;
    rdfs:comment "원본 pd_tr_yn=1이 거래정지다. 값 1을 거래 가능으로 읽으면 의미가 뒤집힌다."@ko .

################################################################################
# 6. 위험등급 — 1이 가장 위험하다
################################################################################

mafp:RiskGrade a owl:Class ; rdfs:label "위험등급"@ko .

mafp:riskGradeValue a owl:DatatypeProperty ;
    rdfs:domain mafp:RiskGradeObservation ;
    rdfs:label "위험등급 값"@ko ;
    rdfs:range [ a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 6 ] ) ] ;
    rdfs:comment "1=매우 높은 위험 ~ 6=매우 낮은 위험. 원본의 0은 미분류이므로 이 범위에 넣지 않는다. '위험등급이 낮은 상품'은 숫자가 낮다는 뜻과 반대이므로 답변에 기준을 명시해야 한다."@ko .

################################################################################
# 7. 신용등급 — 무부호 표기를 정규화하고 서열로 비교한다
################################################################################

mafp:creditGradeCode a owl:DatatypeProperty ;
    rdfs:domain mafp:CreditGradeObservation ; rdfs:range xsd:string ;
    rdfs:label "신용등급"@ko ;
    rdfs:comment "원본 CRD_GRD의 AA0·A0·BBB0은 무부호 표기이므로 AA·A·BBB로 정규화한다. 정규화하지 않으면 'AA 이상' 검색에서 1,713건이 누락된다."@ko .

mafp:creditGradeRank a owl:DatatypeProperty ;
    rdfs:domain mafp:CreditGradeObservation ;
    rdfs:label "신용등급 서열"@ko ;
    rdfs:range [ a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions ( [ xsd:minInclusive 1 ] [ xsd:maxInclusive 20 ] ) ] ;
    rdfs:comment "AAA=1 ~ D=20. 'AA 이상'은 rank<=3이다."@ko .

mafp:evaluatorGradeWorst a owl:DatatypeProperty ;
    rdfs:domain mafp:CreditGradeObservation ; rdfs:range xsd:string ;
    rdfs:label "평가사 최저등급"@ko ;
    rdfs:comment "평가사 간 등급이 갈리면 보수적으로 최저등급을 사용한다."@ko .

################################################################################
# 8. 식별자와 관계
################################################################################

mafp:itemId a owl:DatatypeProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:string ;
    rdfs:label "상품 식별자"@ko .
mafp:isinCode a owl:DatatypeProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:string ;
    rdfs:label "ISIN"@ko ;
    rdfs:comment "해외 ETF에서 50개 ISIN이 각각 두 행에 쓰이므로 기본 키로 사용하지 않는다."@ko .
mafp:productName a owl:DatatypeProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:string ;
    rdfs:label "상품명"@ko .
mafp:sourceTable a owl:DatatypeProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:string .
mafp:sourceRowNumber a owl:DatatypeProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range xsd:integer ;
    rdfs:comment "원본 Excel 행 번호. 모든 답변 근거는 이 값으로 원본까지 역추적된다."@ko .

mafp:Organization a owl:Class ; rdfs:label "기관"@ko .
mafp:AssetManager a owl:Class ; rdfs:subClassOf mafp:Organization ; rdfs:label "자산운용사"@ko ;
    skos:altLabel "AMC"@en , "운용사"@ko .
mafp:Issuer a owl:Class ; rdfs:subClassOf mafp:Organization ; rdfs:label "발행사"@ko .

mafp:managedBy a owl:ObjectProperty ;
    rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:AssetManager ; rdfs:label "운용사"@ko .
mafp:issuedBy a owl:ObjectProperty ;
    rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:Issuer ; rdfs:label "발행사"@ko .
mafp:manages a owl:ObjectProperty ; owl:inverseOf mafp:managedBy ; rdfs:label "운용"@ko .

mafp:BaseIndex a owl:Class ; rdfs:label "기초지수"@ko .
mafp:tracksIndex a owl:ObjectProperty ;
    rdfs:domain mafp:ExchangeTradedProduct ; rdfs:range mafp:BaseIndex ; rdfs:label "추종 지수"@ko ;
    rdfs:comment "공식 스냅샷의 국내 ETF 기초지수는 활성 상품 기준 실효 커버리지가 0이므로 외부 보강 없이는 지수 조건 검색을 지원할 수 없다."@ko .

################################################################################
# 9. Taxonomy — 승인 전 매핑은 확정 매핑처럼 쓰지 않는다
################################################################################

mafp:AssetClass a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "자산군"@ko .
mafp:Region a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "투자지역"@ko .

mafp:hasAssetClass a owl:ObjectProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:AssetClass .
mafp:hasRegion a owl:ObjectProperty ; rdfs:domain mafp:FinancialProduct ; rdfs:range mafp:Region .

mafp:rawClassificationValue a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "원본 분류값"@ko .

mafp:MappingStatus a owl:Class ; rdfs:label "매핑 상태"@ko .
mafp:Mapped a mafp:MappingStatus ; rdfs:label "매핑됨"@ko .
mafp:AmbiguousMapping a mafp:MappingStatus ; rdfs:label "모호"@ko ;
    rdfs:comment "Global Ex US처럼 상위 코드로 묶으면 의미가 달라지는 값. 교차 비교 시 경고해야 한다."@ko .
mafp:Unmapped a mafp:MappingStatus ; rdfs:label "미매핑"@ko .

mafp:hasMappingStatus a owl:ObjectProperty ; rdfs:range mafp:MappingStatus .

################################################################################
# 10. 답변 가능성 — 확인 불가 질의를 구분하기 위한 어휘
################################################################################

mafp:Answerability a owl:Class ; rdfs:label "답변 가능성"@ko .
mafp:Answerable a mafp:Answerability ; rdfs:label "답변 가능"@ko .
mafp:PartialCoverage a mafp:Answerability ; rdfs:label "부분 커버리지"@ko ;
    rdfs:comment "조건에 맞는 상품 중 일부만 값을 가진 상태. 비교 대상과 제외 건수를 답변에 명시한다."@ko .
mafp:UnsupportedField a mafp:Answerability ; rdfs:label "제공 데이터 없음"@ko ;
    rdfs:comment "상품이 없는 것이 아니라 데이터에 필드가 없거나 신뢰할 수 없는 상태. 이 경우 '확인할 수 없음'으로 답한다."@ko .
mafp:NoMatchingProduct a mafp:Answerability ; rdfs:label "조건 불일치"@ko ;
    rdfs:comment "데이터는 있으나 조건에 맞는 상품이 없는 상태. UnsupportedField와 절대 섞지 않는다."@ko .
